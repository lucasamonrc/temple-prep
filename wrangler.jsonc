{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temple-prep",
  "compatibility_date": "2025-03-01",
  "main": "./worker/index.ts",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "templeprep.lucasacastro.com",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "temple-prep-db",
      "database_id": "f14a08db-dd44-4efa-8daf-b5da02f931ee",
    },
  ],
}
