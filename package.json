{
  "name": "temple-prep",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -b",
    "db:migrate:local": "wrangler d1 execute temple-prep-db --local --file=./migrations/0001_initial.sql && wrangler d1 execute temple-prep-db --local --file=./migrations/0002_student_pin.sql",
    "db:migrate": "wrangler d1 execute temple-prep-db --remote --file=./migrations/0001_initial.sql && wrangler d1 execute temple-prep-db --remote --file=./migrations/0002_student_pin.sql",
    "test:e2e": "pnpm --filter e2e test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "hono": "^4.7.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.3.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.31.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
